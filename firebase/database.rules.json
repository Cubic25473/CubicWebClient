{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false }
    },
    "cubic": {
      "members": {
        ".read": true,
        "$id": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name','role','bio','image','order'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "role": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "bio": { ".validate": "newData.isString() && newData.val().length <= 1500" },
          "image": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "order": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999 && newData.val() % 1 === 0" },
          "$other": { ".validate": false }
        }
      },
      "robots": {
        ".read": true,
        "$id": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name','season','description','image','dimensions','weight','programming','materials','drivetrain','featured','order'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "season": { ".validate": "newData.isString() && newData.val().length <= 50" },
          "description": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "image": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "dimensions": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "weight": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "programming": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "materials": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "drivetrain": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "featured": { ".validate": "newData.isBoolean()" },
          "order": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999 && newData.val() % 1 === 0" },
          "specs": {
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9]|1[0-9])$/) && newData.hasChildren(['label','value'])",
              "label": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "value": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
